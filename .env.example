DOCRUNNER_API_KEY=YOUR_DOCRUNNER_API_KEY
DOCRUNNER_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
# Optional: the Claude model that picks the template and reads the request.
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Our agency's countersigner. This person signs as the "pm" role.
AGENCY_COUNTERSIGNER_NAME=Jordan Rep
AGENCY_COUNTERSIGNER_EMAIL=jordan@yourcompany.example
# Every signer address on a test packet is replaced with this one.
TEST_SIGNER_EMAIL=you@yourcompany.example
# Optional: ignore webhooks from any other DocRunner account.
# DOCRUNNER_ACCOUNT_ID=7
# Optional: change the webhook port (default 8000).
# WEBHOOK_PORT=8000
